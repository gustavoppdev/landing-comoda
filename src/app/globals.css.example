/* src/app/globals.css
 *
 * NÃO copie este arquivo por cima do que o `shadcn init` gerou. Ele é
 * referência de ONDE COLAR os três blocos do template dentro do seu
 * globals.css — o `:root` e o `@theme inline` reais são os do seu preset.
 *
 * Todo valor aqui é ilustrativo. A fonte de verdade é o `plan.md`: §1.3 para a
 * escala tipográfica, §2 para os tokens de cor.
 *
 * Regra geral: edite APENAS `:root` e os dois blocos marcados abaixo. O
 * `@theme inline` só espelha nomes — editar ele quebra os componentes instalados.
 */

/* Os imports do topo variam por preset. Mantenha os que o SEU init gerou. */

/* ── BLOCO DO TEMPLATE 1: largura de leitura ──────────────────────────────
   Usada no wrapper INTERNO de cada seção. O fundo continua full-bleed na
   <section> e só o conteúdo é limitado — é o que preserva o ritmo de faixas
   de cor do plan.md §2. A largura máxima e o padding vêm de plan.md §1.2;
   `container` sozinho vai a 1536px, largo demais para uma coluna de leitura. */
@layer utilities {
  .section-container {
    @apply mx-auto w-full max-w-6xl px-5 md:px-11;
  }
}

/* ── BLOCO DO TEMPLATE 2: escala tipográfica ──────────────────────────────
   Transcrição de plan.md §1.3. Bloco @theme próprio porque o @theme inline
   gerado pelo shadcn não é editado.
   Sufixo -lg = desktop; sem sufixo = mobile (mobile-first).
   Uso no JSX: `text-h1 md:text-h1-lg` — nunca `text-[30px]`. */
@theme {
  --text-h1: 1.875rem; /* 30px */
  --text-h1--line-height: 1.14;
  --text-h1--letter-spacing: -0.03em;
  --text-h1--font-weight: 500;
  --text-h1-lg: 3.375rem; /* 54px */
  --text-h1-lg--line-height: 1.08;
  --text-h1-lg--letter-spacing: -0.03em;
  --text-h1-lg--font-weight: 500;

  --text-h2: 1.5rem; /* 24px */
  --text-h2--line-height: 1.2;
  --text-h2--letter-spacing: -0.028em;
  --text-h2--font-weight: 500;
  --text-h2-lg: 2.375rem; /* 38px */
  --text-h2-lg--line-height: 1.14;
  --text-h2-lg--letter-spacing: -0.028em;
  --text-h2-lg--font-weight: 500;

  --text-h3: 1rem; /* 16px */
  --text-h3--line-height: 1.3;
  --text-h3--font-weight: 500;
  --text-h3-lg: 1.3125rem; /* 21px */
  --text-h3-lg--line-height: 1.3;
  --text-h3-lg--font-weight: 500;

  --text-lead: 0.875rem; /* 14px */
  --text-lead--line-height: 1.5;
  --text-lead--font-weight: 400;
  --text-lead-lg: 1.0625rem; /* 17px */
  --text-lead-lg--line-height: 1.6;
  --text-lead-lg--font-weight: 400;

  --text-body: 0.9375rem; /* 15px — abaixo de 14px vira risco de legibilidade */
  --text-body--line-height: 1.55;
  --text-body--font-weight: 400;
  --text-body-lg: 1rem; /* 16px */
  --text-body-lg--line-height: 1.55;
  --text-body-lg--font-weight: 400;

  --text-label: 0.6875rem; /* 11px */
  --text-label--line-height: 1.4;
  --text-label--letter-spacing: 0.12em;
  --text-label--font-weight: 500;
  --text-label-lg: 0.75rem; /* 12px */
  --text-label-lg--line-height: 1.4;
  --text-label-lg--letter-spacing: 0.12em;
  --text-label-lg--font-weight: 500;

  --text-stat: 1.625rem; /* 26px */
  --text-stat--line-height: 1.05;
  --text-stat--letter-spacing: -0.035em;
  --text-stat--font-weight: 500;
  --text-stat-lg: 2.5rem; /* 40px */
  --text-stat-lg--line-height: 1.05;
  --text-stat-lg--letter-spacing: -0.035em;
  --text-stat-lg--font-weight: 500;
}

/* ── NÃO EDITAR: o `@theme inline` que o seu `init` gerou fica aqui ────────
   Não está reproduzido neste arquivo de propósito: ele varia por preset
   (chart-*, sidebar-*, --radius-4xl) e copiar o de outro projeto quebra os
   componentes instalados. Abra o seu e anote dois nomes dele, porque o bloco
   abaixo depende deles:
     1. o que `--font-sans` consome   → normalmente `var(--font-sans)`
     2. o que `--font-mono` consome   → normalmente `var(--font-geist-mono)`
   Esses são os nomes que o `next/font` precisa injetar no layout.tsx. */

/* ── BLOCO DO TEMPLATE 3: tokens de marca ─────────────────────────────────
   Segundo `:root`, colado DEPOIS do que o `init` gerou: em CSS, `:root`
   repetido faz o último valor de cada propriedade vencer, e o que este bloco
   não toca continua com o default do preset.
   Transcreva de plan.md §2 SÓ o que substitui um default. Recopiar o valor
   que já era o do preset não muda nada e esconde o que de fato mudou. */
:root {
  --radius: 1.125rem; /* 18px */

  /* Cor de ação — CTA e seções escuras */
  --primary: oklch(0.34 0.052 155);
  --primary-foreground: oklch(0.985 0 0);

  /* Destaque — exclusivo de fundo escuro */
  --accent: oklch(0.93 0.137 116);
  --accent-foreground: oklch(0.19 0.012 110);

  --muted-foreground: oklch(0.52 0 0);

  /* --ring segue --primary neste projeto */
  --ring: oklch(0.34 0.052 155);
}

/* NÃO há alias de fonte aqui, e isso é deliberado.
   As fontes se ligam no layout.tsx: o `next/font` recebe `variable` com o
   MESMO nome que o `@theme inline` do preset consome (`--font-sans`,
   `--font-geist-mono`). O create-next-app gera `--font-geist-sans`, que o
   preset não consome — é por isso que "a fonte carrega e nada usa ela".
   Renomear lá resolve; alias aqui só empurra o problema, e briga com a
   variável que o next/font já define no <html>. */

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}
